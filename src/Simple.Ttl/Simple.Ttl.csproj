<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>
			Simple wrappers of value with TTL as:
			public T GetOrCreate(Func&lt;T&gt; factory)
			=&gt; IsExpired ? value = EnsureValue(factory) : value!;
		</Description>
		<PackageTags>Simple;TTL;Cache</PackageTags>
		<Title>Simple wrappers of value with TTL</Title>

		<AssemblyVersion>8.0.1.6</AssemblyVersion>
		<Version>8.0.1</Version>

		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>CS1591</NoWarn>
	</PropertyGroup>

</Project>